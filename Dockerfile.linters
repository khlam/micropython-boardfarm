# Dedicated Dockerfile for linters used in local git precommit and CI/CD.
# No TypeScript/ESLint stages: this repo is Python (MicroPython firmware +
# host viz/tests) plus Dockerfiles and YAML.

FROM ghcr.io/astral-sh/uv:0.8.15@sha256:a5727064a0de127bdb7c9d3c1383f3a9ac307d9f2d8a391edc7896c54289ced0 AS uv

# Ruff linter/formatter for Python
FROM ghcr.io/astral-sh/ruff:0.12.12@sha256:b23038588fb44f1adecd647dd19480e1861085eef790e1b0f3e30a6a89568033 AS ruff-lint
WORKDIR /work

# Hadolint for Dockerfile
FROM hadolint/hadolint:v2.13.1@sha256:1fd499f411a9ff121fda3207af1c8d32e2a92648c19fb1847553c5b79ca4c281 AS hadolint-lint
WORKDIR /work
ENTRYPOINT ["hadolint"]

# Yamllint for YAML linting
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS yamllint-lint
ENV UV_LINK_MODE=copy
COPY --from=uv /uv /usr/local/bin/uv
RUN uv pip install --system "yamllint==1.37.1"
WORKDIR /work
ENTRYPOINT ["yamllint"]

# Yamlfix (formatter) for YAML files
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS yamlfix-fmt
ENV UV_LINK_MODE=copy
COPY --from=uv /uv /usr/local/bin/uv
RUN uv pip install --system "yamlfix==1.18.0"
WORKDIR /work
ENTRYPOINT ["yamlfix"]

# Vulture for dead code detection
FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS vulture-lint
ENV UV_LINK_MODE=copy
COPY --from=uv /uv /usr/local/bin/uv
RUN uv pip install --system "vulture==2.14"
WORKDIR /work
ENTRYPOINT ["vulture"]
