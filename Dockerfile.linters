FROM ghcr.io/astral-sh/uv:0.11.18@sha256:78bc42400d77b0678ba95765305c826652ed5431f399257271dda681d0318f03 AS uv

# Tool versions come from pyproject.toml + uv.lock.
FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS python-lint-base
ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/boardfarm-lint
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /work
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --only-group lint
ENV PATH=/opt/boardfarm-lint/bin:${PATH}

FROM python-lint-base AS ruff-lint
ENTRYPOINT ["ruff"]

FROM hadolint/hadolint:v2.14.0@sha256:27086352fd5e1907ea2b934eb1023f217c5ae087992eb59fde121dce9c9ff21e AS hadolint-lint
WORKDIR /work
ENTRYPOINT ["hadolint"]

FROM python-lint-base AS yamllint-lint
ENTRYPOINT ["yamllint"]

FROM python-lint-base AS yamlfix-fmt
ENTRYPOINT ["yamlfix"]

FROM python-lint-base AS vulture-lint
ENTRYPOINT ["vulture"]

FROM python-lint-base AS pydoclint-lint
ENTRYPOINT ["pydoclint"]

FROM python-lint-base AS uv-secure
ENTRYPOINT ["sh", "-c", "\
  lock=\"${1:-uv.lock}\"; \
  out=\"$(uv-secure --no-check-uv-tool --no-check-uv-secure \"$lock\" 2>&1 || true)\"; \
  echo \"$out\"; \
  if echo \"$out\" | awk -F '│' 'NF > 1 {fix=$5; gsub(/[[:space:]]/, \"\", fix); if (fix != \"\") found=1} END{exit found ? 0 : 1}'; then \
    echo '[uv-secure] At least one vulnerable dependency has a fixed release.'; \
    exit 1; \
  else \
    echo '[uv-secure] Scan completed without fixable vulnerability rows.'; \
  fi", "--"]
