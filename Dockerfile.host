# Host-Python stages: wheels (internal-package wheel builder), viz (FastAPI
# dashboard, port 18501) and uv-runner (standalone uv to regenerate uv.lock).
# viz/uv-runner consume the lockfile that uv-runner produces; viz pins
# fastapi/uvicorn/pyserial transitively.

FROM ghcr.io/astral-sh/uv:0.11.18@sha256:78bc42400d77b0678ba95765305c826652ed5431f399257271dda681d0318f03 AS uv-bin


# -----------------------------------------------------------------------------
# Stage: wheels — builds wheels for every internal package into /wheels,
# consumed as a flat file:// index (see [tool.uv.index] "internal" in
# pyproject.toml). Resolving internal packages from this index — instead of
# workspace source overrides — is what makes uv enforce the inter-package
# version floors at lock time. Shared with the pytest/typecheck stages
# (Dockerfile.tests) via Compose `additional_contexts: wheels: service:wheels`,
# so the build logic lives here once. SOURCE_DATE_EPOCH is load-bearing: uv
# records each wheel's hash in uv.lock and `uv sync --frozen` re-verifies it, so
# builds must be reproducible.
#
# bump version in package pyproject.toml
#   └─> wheels stage builds versioned wheel → /wheels (reproducible)
#        └─> uv resolves from "internal" index, enforcing >= floors
#             └─> uv.lock records resolved versions + hashes
#                  └─> uv sync --frozen re-verifies everywhere
# -----------------------------------------------------------------------------
FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS wheels
ENV SOURCE_DATE_EPOCH=315532800 \
    UV_LINK_MODE=copy
COPY --from=uv-bin /uv /usr/local/bin/uv
WORKDIR /src
COPY firmware-packages ./firmware-packages
COPY cpython-packages ./cpython-packages
RUN for d in firmware-packages/*/ cpython-packages/*/; do uv build "$d" -o /wheels; done


# -----------------------------------------------------------------------------
# Stage: viz — host FastAPI dashboard on port 18501 (serial → WebSocket → Plotly).
# Per-project static/ comes via VIZ_DIR build-arg; build context must be repo root.
# -----------------------------------------------------------------------------
FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS viz
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=uv-bin /uv /usr/local/bin/uv
WORKDIR /app

# Install serial_over_web from its wheel (/wheels, via the "internal" file://
# index); transitive fastapi/uvicorn/pyserial come from PyPI per uv.lock.
COPY --from=wheels /wheels /wheels
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --only-group viz
ENV PATH=/app/.venv/bin:${PATH}

# Per-project dashboard at /app/static; STATIC_DIR overrides the package default.
ARG VIZ_DIR=projects/distance-stream/viz
COPY ${VIZ_DIR}/static ./static
ENV STATIC_DIR=/app/static

EXPOSE 18501
ENTRYPOINT ["uvicorn"]
CMD ["serial_over_web.app:app", "--host", "0.0.0.0", "--port", "18501"]


# -----------------------------------------------------------------------------
# Stage: uv-runner — standalone uv to regenerate uv.lock against the
# bind-mounted repo. Used by the `uv` service in docker-compose.yaml; consumed
# by viz + pytest (Dockerfile.tests) via `uv sync --frozen`.
# -----------------------------------------------------------------------------
FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS uv-runner
ENV UV_LINK_MODE=copy
COPY --from=uv-bin /uv /usr/local/bin/uv
# /wheels (from the wheels stage, shared via additional_contexts) lets `uv lock`
# resolve the internal file:// index — where version-floor enforcement happens.
COPY --from=wheels /wheels /wheels
WORKDIR /workspace
ENTRYPOINT ["uv"]
