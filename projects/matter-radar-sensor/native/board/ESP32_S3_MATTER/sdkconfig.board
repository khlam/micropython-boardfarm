CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0xC000

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_MBEDTLS_HKDF_C=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# This board powers the ESP32-S3, PSRAM, and LD2420 from one small regulator.
# Keep compute and radio peaks inside that shared supply's narrow margin.
#
# Dynamic frequency scaling drops the CPU toward the 40 MHz crystal whenever no
# peripheral holds a power-management lock, while the 80 MHz ceiling bounds
# active current during Matter cryptography and network processing.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_PM_DFS_INIT_AUTO=y
# Wi-Fi association is the current peak that trips the detector, and the power
# amplifier is most of it. 13 dBm trades range for a supply this board can hold.
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=13
# Keep BLE commissioning current below its default +9 dBm peak.
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_N0=y

CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_ENABLE_OTA_REQUESTOR=n
CONFIG_ENABLE_ENCRYPTED_OTA=n
# Counts the root node endpoint alongside the application's own, so this is one
# more than the number `main.py` creates. Each slot costs RAM whether or not it
# is filled, so it tracks the firmware rather than being set generously.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=3

CONFIG_ENABLE_ESP32_FACTORY_DATA_PROVIDER=y
CONFIG_FACTORY_COMMISSIONABLE_DATA_PROVIDER=y
CONFIG_EXAMPLE_DAC_PROVIDER=y
CONFIG_ENABLE_ESP32_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_FACTORY_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_ENABLE_TEST_SETUP_PARAMS=n
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="fctry"
CONFIG_DEVICE_VENDOR_ID=0xFFF1
CONFIG_DEVICE_PRODUCT_ID=0x8002

CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# CHIP_LOG_DEFAULT_LEVEL follows LOG_DEFAULT_LEVEL, and CHIP decides at compile
# time what it can say at all: at NONE the stack cannot report why a
# commissioning attempt failed, which is the one thing worth knowing when Apple
# Home refuses to pair. Log lines are not JSON, and both the viz reader and the
# dashboard drop every line that is not, so neither is affected.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
