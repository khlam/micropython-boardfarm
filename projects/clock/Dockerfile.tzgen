# -----------------------------------------------------------------------------
# tzgen — host-only generator of the tz_offset timezone dataset. Installs
# shapely + tzdata here (never on the host, never in firmware); its committed
# output `_tzdata.py` is regenerated deliberately, not on every build. Prints the
# module text to stdout, which the operator redirects into the package:
#   docker compose run --rm tzgen > firmware-packages/tz_offset/tz_offset/_tzdata.py
# Its synthetic-fixture tests run here too (shapely/tzdata are present):
#   docker compose run --rm --entrypoint pytest tzgen /work/projects/clock/tzgen/tests
# libgeos-dev is a fallback for Python versions lacking a prebuilt shapely wheel.
# Build context is the repo root (see docker-compose.yaml).
# -----------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.11.18@sha256:78bc42400d77b0678ba95765305c826652ed5431f399257271dda681d0318f03 AS uv-bin

FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS tzgen
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/work/projects/clock/tzgen \
    UV_LINK_MODE=copy \
    UV_SYSTEM_PYTHON=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgeos-dev ca-certificates \
 && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=uv-bin /uv /usr/local/bin/uv
RUN uv pip install --system shapely tzdata pytest
WORKDIR /work
COPY projects/clock/tzgen /work/projects/clock/tzgen
ENTRYPOINT ["python", "-m", "tzgen"]
CMD []
