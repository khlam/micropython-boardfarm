# Native ESP-Matter toolchain. Compilation publishes reusable firmware;
# flashing publishes the image and pairing artifacts for the connected board.

# renovate: datasource=docker depName=espressif/idf
ARG ESP_IDF_IMAGE=espressif/idf:v5.5.5@sha256:a9231d0697ab8f7517cc072e93b7c83e04907bfbfba80b6440d7dbbf90665cf2
# renovate: datasource=git-refs depName=espressif/esp-matter
ARG ESP_MATTER_COMMIT=2c125619610b9a16bb8e92f5ebbf55111638615e
# renovate: datasource=git-refs depName=project-chip/connectedhomeip
ARG CONNECTEDHOMEIP_COMMIT=d46cc8c2886cbefc338544bdb2e2f8128f3e9970
# renovate: datasource=git-refs depName=micropython/micropython
ARG MICROPYTHON_COMMIT=e0e9fbb17ed6fd06bb76e266ae554784c9c80804
# renovate: datasource=pypi depName=cryptography
ARG CRYPTOGRAPHY_VERSION=50.0.0
# renovate: datasource=pypi depName=qrcode
ARG QRCODE_VERSION=8.2
# renovate: datasource=pypi depName=esp-idf-nvs-partition-gen
ARG ESP_IDF_NVS_PARTITION_GEN_VERSION=0.3.0


FROM ghcr.io/astral-sh/uv:0.11.18@sha256:78bc42400d77b0678ba95765305c826652ed5431f399257271dda681d0318f03 AS uv-bin


# Locked Python sources for the MicroPython compiler; no host bytecode is shipped.
FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS firmware-dependencies
COPY --from=uv-bin /uv /usr/local/bin/uv
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --only-group firmware --no-emit-workspace -o /requirements.txt \
 && uv pip install --require-hashes --no-deps --target /installed -r /requirements.txt
WORKDIR /installed/microdot
RUN mkdir -p /firmware-dependencies/microdot \
 && cp -p __init__.py microdot.py websocket.py helpers.py /firmware-dependencies/microdot/


FROM ${ESP_IDF_IMAGE} AS matter-toolchain

ARG ESP_MATTER_COMMIT
ARG CONNECTEDHOMEIP_COMMIT
ARG MICROPYTHON_COMMIT
ARG CRYPTOGRAPHY_VERSION
ARG QRCODE_VERSION
ARG ESP_IDF_NVS_PARTITION_GEN_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    CCACHE_DIR=/build-cache/ccache \
    ESP_MATTER_PATH=/opt/esp-matter \
    IDF_CCACHE_ENABLE=1 \
    MATTER_SDK_PATH=/opt/esp-matter/connectedhomeip/connectedhomeip \
    MICROPYTHON_TOP=/opt/micropython

RUN apt-get update \
 && apt-get install -y --no-install-recommends ccache libffi-dev python3-dev python3-pip \
 && rm -rf /var/lib/apt/lists/*

RUN git init /opt/esp-matter \
 && git -C /opt/esp-matter remote add origin https://github.com/espressif/esp-matter.git \
 && git -C /opt/esp-matter fetch --depth 1 origin ${ESP_MATTER_COMMIT} \
 && git -C /opt/esp-matter checkout --detach ${ESP_MATTER_COMMIT} \
 && git -C /opt/esp-matter submodule update --init --depth 1 connectedhomeip/connectedhomeip \
 && python3 /opt/esp-matter/connectedhomeip/connectedhomeip/scripts/checkout_submodules.py \
      --platform esp32 --shallow --jobs 8 \
 && test "$(git -C /opt/esp-matter/connectedhomeip/connectedhomeip rev-parse HEAD)" = "${CONNECTEDHOMEIP_COMMIT}"

RUN git init /opt/micropython \
 && git -C /opt/micropython remote add origin https://github.com/micropython/micropython.git \
 && git -C /opt/micropython fetch --depth 1 origin ${MICROPYTHON_COMMIT} \
 && git -C /opt/micropython checkout --detach ${MICROPYTHON_COMMIT}

# mpy-cross compiles the frozen manifest; the esp32 port cannot configure until
# its submodules are fetched.
RUN make -C /opt/micropython/mpy-cross -j"$(nproc)" \
 && IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh \
 && make -C /opt/micropython/ports/esp32 submodules

RUN IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh \
 && cd /opt/esp-matter \
 && ./install.sh --no-host-tool

RUN IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh \
 && . /opt/esp-matter/export.sh \
 && python3 -m pip uninstall -y esp-matter-mfg-tool \
 && python3 -m pip install --no-cache-dir --break-system-packages \
      cryptography==${CRYPTOGRAPHY_VERSION} \
      "qrcode[pil]==${QRCODE_VERSION}" \
      esp-idf-nvs-partition-gen==${ESP_IDF_NVS_PARTITION_GEN_VERSION}

# The callers in /matter-tools import matter_tools. --no-deps keeps the pins
# above authoritative; copying only this wheel keeps the layer cached until
# matter_tools itself changes.
COPY --from=wheels /wheels/matter_tools-*.whl /tmp/wheels/
RUN IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh \
 && python3 -m pip install --no-cache-dir --break-system-packages --no-deps /tmp/wheels/matter_tools-*.whl \
 && rm -rf /tmp/wheels

RUN mkdir -p /build-cache /outputs

COPY --from=firmware-dependencies /firmware-dependencies /firmware-dependencies
COPY manifest.py /manifest.py

ENTRYPOINT ["bash", "-ceu", "\
  IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh; \
  . /opt/esp-matter/export.sh; \
  exec python3 /matter-tools/build.py \
"]


FROM matter-toolchain AS matter-monitor

ENTRYPOINT ["bash", "-ceu", "\
  port=${SERIAL_PORT:-/dev/ttyACM0}; \
  [[ -e $port ]] || { \
    echo \"ERROR: serial port $port not found. Plug in the ESP32-S3.\" >&2; \
    exit 1; \
  }; \
  if [[ ${MONITOR_RESET:-1} == 0 ]]; then reset_flag=--no-reset; else reset_flag=; fi; \
  if [[ ${MONITOR_PROBE:-0} == 1 ]]; then probe_flag=--probe; else probe_flag=; fi; \
  if [[ ${MONITOR_INTERRUPT:-0} == 1 ]]; then interrupt_flag=--interrupt; else interrupt_flag=; fi; \
  IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh; \
  exec python3 /matter-tools/serial_monitor.py \
    --port \"$port\" \
    --baud \"${MONITOR_BAUD:-115200}\" \
    --seconds \"${MONITOR_SECONDS:-90}\" $reset_flag $probe_flag $interrupt_flag \
    --send \"${MONITOR_SEND:-}\" \
"]


# Provision and flash the connected board using the compiled image.
FROM matter-toolchain AS matter-flash

ENTRYPOINT ["bash", "-ceu", "\
  IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh; \
  exec python3 /matter-tools/provision.py \
    --port \"${SERIAL_PORT:-/dev/ttyACM0}\" \
    --passcode \"${PASSCODE:-}\" \
    --manufacturer \"${MANUFACTURER:-}\" \
    --serial-number \"${SERIAL_NUMBER:-}\" \
"]
