# Host CPython pytest and typecheck stages.

FROM ghcr.io/astral-sh/uv:0.11.18@sha256:78bc42400d77b0678ba95765305c826652ed5431f399257271dda681d0318f03 AS uv-bin

FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS pytest
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy
COPY --from=uv-bin /uv /usr/local/bin/uv
WORKDIR /work

# Internal packages install from /wheels (built by the wheels stage in
# Dockerfile.host, exposed via the "internal" file:// index in pyproject.toml).
# Only the lockfile + workspace
# member pyprojects are needed for `uv sync --frozen` to resolve and validate.
COPY --from=wheels /wheels /wheels
COPY pyproject.toml uv.lock ./
# Project pyprojects are virtual workspace members (no source dir to install);
# uv needs them present to validate the frozen lock.
COPY projects/compass/pyproject.toml ./projects/compass/pyproject.toml
COPY projects/distance-stream/pyproject.toml ./projects/distance-stream/pyproject.toml
COPY projects/gps/pyproject.toml ./projects/gps/pyproject.toml
COPY projects/gyro-stream/pyproject.toml ./projects/gyro-stream/pyproject.toml
COPY projects/multizone-ranging/pyproject.toml ./projects/multizone-ranging/pyproject.toml
RUN uv sync --frozen --no-dev --no-install-project --group test
ENV PATH=/work/.venv/bin:${PATH}

# Full-suite runs enforce coverage; targeted runs do not.
# TODO: Simplify/make readable
ENTRYPOINT ["sh", "-c", \
  "if [ \"$*\" = '/firmware-packages /projects /cpython-packages/serial_over_web/tests' ]; \
     then COV_GATE='--cov-fail-under=90'; \
     else COV_GATE='--cov-fail-under=0'; \
   fi && \
   exec pytest -v -p no:cacheprovider --import-mode=importlib --rootdir=/ \
                -c /work/pyproject.toml --cov --cov-report=term-missing \
                --cov-config=/work/pyproject.toml $COV_GATE \"$@\"", \
  "--"]
CMD ["/firmware-packages", "/projects", "/cpython-packages/serial_over_web/tests"]


# ty over the workspace.
FROM pytest AS typecheck
ENV VIRTUAL_ENV=/work/.venv
ENTRYPOINT ["sh", "-c", "exec ty check --output-format concise \"$@\"", "--"]
CMD []
