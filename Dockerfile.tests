# Host CPython pytest runner. Each workspace member is installed editable.
# --rootdir=/ unifies bind-mounted test dirs under one rootdir;
# --import-mode=importlib avoids basename collisions between the two
# test_emit_schema.py files (distance-stream + gyro-stream).

FROM ghcr.io/astral-sh/uv:0.11.2 AS uv-bin

FROM python:3.13-slim@sha256:b04b5d7233d2ad9c379e22ea8927cd1378cd15c60d4ef876c065b25ea8fb3bf3 AS pytest
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy
COPY --from=uv-bin /uv /usr/local/bin/uv
WORKDIR /work

# Each workspace member's pyproject + source must be present for `uv sync` to
# install editable. --frozen makes any drift from uv.lock fail the build.
COPY pyproject.toml uv.lock ./
COPY cpython-packages/serial_over_web/pyproject.toml ./cpython-packages/serial_over_web/pyproject.toml
COPY cpython-packages/serial_over_web/serial_over_web ./cpython-packages/serial_over_web/serial_over_web
COPY cpython-packages/micropython_stubs/pyproject.toml ./cpython-packages/micropython_stubs/pyproject.toml
COPY cpython-packages/micropython_stubs/micropython_stubs ./cpython-packages/micropython_stubs/micropython_stubs
COPY firmware-packages/boot_status_led/pyproject.toml ./firmware-packages/boot_status_led/pyproject.toml
COPY firmware-packages/boot_status_led/boot_status_led ./firmware-packages/boot_status_led/boot_status_led
COPY firmware-packages/i2c_bus/pyproject.toml ./firmware-packages/i2c_bus/pyproject.toml
COPY firmware-packages/i2c_bus/i2c_bus ./firmware-packages/i2c_bus/i2c_bus
COPY firmware-packages/mpu6050/pyproject.toml ./firmware-packages/mpu6050/pyproject.toml
COPY firmware-packages/mpu6050/mpu6050 ./firmware-packages/mpu6050/mpu6050
COPY firmware-packages/vl53l0x/pyproject.toml ./firmware-packages/vl53l0x/pyproject.toml
COPY firmware-packages/vl53l0x/vl53l0x ./firmware-packages/vl53l0x/vl53l0x
COPY .githooks/check_project_compat.sh /check_project_compat.sh
RUN uv sync --frozen --no-dev --no-install-project --group test
ENV PATH=/work/.venv/bin:${PATH}

# Preflight: each project's micropython-boardfarm>=… floor must be satisfied
# by root. The 90% coverage gate only fires for the default CMD (full suite);
# targeted runs get --cov-fail-under=0. Keep the if-comparison string in sync
# with CMD below.
ENTRYPOINT ["sh", "-c", \
  "bash /check_project_compat.sh /work/pyproject.toml /projects/*/pyproject.toml && \
   if [ \"$*\" = '/firmware-packages /projects /cpython-packages/serial_over_web/tests' ]; \
     then COV_GATE='--cov-fail-under=90'; \
     else COV_GATE='--cov-fail-under=0'; \
   fi && \
   exec pytest -v -p no:cacheprovider --import-mode=importlib --rootdir=/ \
                -c /work/pyproject.toml --cov --cov-report=term-missing \
                --cov-config=/work/pyproject.toml $COV_GATE \"$@\"", \
  "--"]
CMD ["/firmware-packages", "/projects", "/cpython-packages/serial_over_web/tests"]
# Trailing `"--"` in ENTRYPOINT is sh's $0 placeholder; CMD/run-args become
# $1.. so `"$@"` forwards cleanly to pytest.
