# Firmware compile and flash stages.

ARG MICROPYTHON_REF=v1.28.0


# Concatenates RP2040 + RP2350 universal UF2.
FROM ubuntu:24.04@sha256:c4a8d5503dfb2a3eb8ab5f807da5bc69a85730fb49b5cfca2330194ebcc41c7b AS rp

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    python3-pip \
    cmake \
    gcc-arm-none-eabi \
    binutils-arm-none-eabi \
    libnewlib-arm-none-eabi \
    libnewlib-dev \
    libstdc++-arm-none-eabi-newlib \
    libstdc++-arm-none-eabi-dev \
    libffi-dev \
    pkg-config \
    wget \
    unzip \
    git \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /outputs
WORKDIR /app

ARG MICROPYTHON_REF
RUN git clone --depth 1 --branch ${MICROPYTHON_REF} \
      https://github.com/micropython/micropython.git

WORKDIR /app/micropython
RUN make -C mpy-cross -j$(nproc)

RUN make -C ports/rp2 BOARD=RPI_PICO submodules \
 && make -C ports/rp2 BOARD=RPI_PICO2_W submodules

ENV PICO_SDK_PATH=/app/micropython/lib/pico-sdk
WORKDIR /app/micropython/ports/rp2

COPY manifest.py /manifest.py

ENTRYPOINT ["sh","-c", "\
  set -e; \
  bash /check_project_compat.sh /root_pyproject.toml /project_pyproject.toml; \
  for B in RPI_PICO RPI_PICO2_W; do \
    cmake -S . -B /build-cache/$B \
      -DPICO_SDK_PATH=${PICO_SDK_PATH} \
      -DUPDATE_SUBMODULES=OFF \
      -DPICO_BUILD_DOCS=0 \
      -DMICROPY_BOARD=$B \
      -DMICROPY_BOARD_DIR=$(pwd)/boards/$B \
      -DMICROPY_FROZEN_MANIFEST=/manifest.py; \
    cmake --build /build-cache/$B -- -j$(nproc); \
  done; \
  cat /build-cache/RPI_PICO/firmware.uf2 /build-cache/RPI_PICO2_W/firmware.uf2 \
    > /outputs/app.rp2040.rp2350.uf2; \
  echo '/outputs/app.rp2040.rp2350.uf2 ready'"]


# ESP32-S3 compile-only stage.
FROM espressif/idf:v5.5.1@sha256:dfa2d076c796769c07c155eba6c672b9f395aec943b2ba3701b73379b5f9e884 AS esp32-compile

ENV DEBIAN_FRONTEND=noninteractive

RUN mkdir -p /outputs
WORKDIR /app

ARG MICROPYTHON_REF
RUN git clone --depth 1 --branch ${MICROPYTHON_REF} \
      https://github.com/micropython/micropython.git

WORKDIR /app/micropython
RUN make -C mpy-cross -j$(nproc)

RUN IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh \
 && make -C ports/esp32 submodules

COPY manifest.py /manifest.py

# Do not pass BUILD=...; it corrupts recursive mpy-cross qstr generation.
ENTRYPOINT ["sh","-c", "\
  set -e; \
  bash /check_project_compat.sh /root_pyproject.toml /project_pyproject.toml; \
  IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh; \
  make -C ports/esp32 \
    BOARD=ESP32_GENERIC_S3 \
    FROZEN_MANIFEST=/manifest.py \
    -j$(nproc); \
  cp ports/esp32/build-ESP32_GENERIC_S3/firmware.bin /outputs/app.esp32-s3.bin; \
  echo '/outputs/app.esp32-s3.bin ready'"]


# ESP32-S3 flash existing compiled bin.
FROM esp32-compile AS esp32-flash

ENTRYPOINT ["sh","-c", "\
  set -e; \
  bash /check_project_compat.sh /root_pyproject.toml /project_pyproject.toml; \
  if [ ! -s /outputs/app.esp32-s3.bin ]; then \
    echo 'ERROR: /outputs/app.esp32-s3.bin not found. Run esp32-compile first.' >&2; \
    exit 1; \
  fi; \
  if [ ! -e /dev/ttyACM0 ]; then \
    echo 'ERROR: /dev/ttyACM0 not found.' >&2; \
    echo 'Plug in the ESP32-S3 in bootloader mode (hold BOOT, tap RESET).' >&2; \
    exit 1; \
  fi; \
  IDF_PATH_FORCE=1 . /opt/esp/idf/export.sh; \
  esptool.py --chip esp32s3 --port /dev/ttyACM0 write_flash -z 0x0 \
    /outputs/app.esp32-s3.bin"]
