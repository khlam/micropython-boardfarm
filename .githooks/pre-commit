#!/usr/bin/env bash
# Pre-commit hook: thin shim that runs `make precommit`. The entire pre-commit
# definition — auto-fix staged Python (ruff format + ruff check --fix), then
# verify ruff + pydoclint + ty on staged Python — lives self-contained in the
# Makefile. Change linter invocations there.
#
# Heavier global gates stay in CI, not here: version-bump and project-compat
# guards, vendored-file enforcement, vulture, and the repo-wide hadolint /
# yamllint sweep (see .github/workflows/ci.yml).

set -euo pipefail
exec make -C "$(git rev-parse --show-toplevel)" precommit
